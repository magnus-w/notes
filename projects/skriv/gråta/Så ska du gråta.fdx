  <ScriptNotes>
    <ScriptNote Color="#000000000000" DateModified="20250619T204516" DateTime="20250619T204444" Id="1" Name="" Range="0,0" RefId="88d3480d-986a-4670-80e3-ad4467bbc83a" Type="" WriterID="00uvg25qxwpkDN3Vb417" WriterName="undefined">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5de66de9-46dc-4d80-a544-986fac2b3d4b">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Use the Scene Citation element to label your scene.</Text>
      </Paragraph>
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6497b49b-af51-447c-b237-bc81257b7136">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">
Pressing Enter/Return will automatically take you to the Notations element.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#000000000000" DateModified="20250619T204600" DateTime="20250619T204518" Id="2" Name="" Range="30,30" RefId="6c5f274f-c525-41c4-a04c-171b3424c6ff" Type="" WriterID="00uvg25qxwpkDN3Vb417" WriterName="undefined">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="336e5d60-3b2a-4fe5-b87f-4c673432c920">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">On the Title Page, include either your contact information or that of your representation -- not both.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#000000000000" DateModified="20250619T222912" DateTime="20250619T204605" Id="3" Name="" Range="259,259" RefId="55921f57-1534-439b-8e7a-ca59910a7728" Type="" WriterID="00uvg25qxwpkDN3Vb417" WriterName="undefined">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="b082d1e5-40ac-4456-8c91-6db5566bfc70">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">There are many ways to paginate your play, from the straight forward numerical sequence of 1, 2, 3 to an older format of I-2-16, (meaning Act 1, Scene 2, Page 16).</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#000000000000" DateModified="20250619T205000" DateTime="20250619T204801" Id="4" Name="" Range="327,327" RefId="454b67d3-8917-4e96-b328-991de7e8524c" Type="" WriterID="00uvg25qxwpkDN3Vb417" WriterName="undefined">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="73da060c-ec02-45df-9d9e-f0d5da125594">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">This is a ScriptNote.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#000000000000" DateModified="20250619T205024" DateTime="20250619T205002" Id="5" Name="" Range="2361,2361" RefId="ec3cc553-3965-4912-8a40-a9fd8d25b9a1" Type="" WriterID="00uvg25qxwpkDN3Vb417" WriterName="undefined">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a1649b27-81f0-4248-97ac-7f8dd3830b9a">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Character names are placed in all caps to distinguish their actions.  After these initial directions, the character names return to regular formatting.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#000000000000" DateModified="20250619T205122" DateTime="20250619T205110" Id="6" Name="" Range="2366,2366" RefId="a8216b27-6bbd-444b-92c2-109fef369b05" Type="" WriterID="00uvg25qxwpkDN3Vb417" WriterName="undefined">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="3b12659f-e7f5-480e-ba93-938ce3b590c8">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Use the Parenthetical element for stage action reliant on the proceeding dialogue.</Text>
      </Paragraph>
    </ScriptNote>
  </ScriptNotes>

